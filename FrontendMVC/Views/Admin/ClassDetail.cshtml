                            await refreshStudentDropdown();
                        } else {
                            showMessage('error', result.message || 'Không thể xóa học sinh khỏi lớp.');
                            if (submitBtn) {
                                submitBtn.disabled = false;
                                submitBtn.innerText = ' Xóa khỏi lớp';
