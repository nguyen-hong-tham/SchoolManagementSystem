@model AdminCreateUserRequest
@{
    ViewData["Title"] = "Thêm Người Dùng Mới";
    Layout = "_Layout";
    var classes = ViewBag.Classes as IEnumerable<ClassViewModel> ?? new List<ClassViewModel>();
}

<div class="mb-3">
    <a asp-action="Users" class="btn btn-secondary" style="padding: 8px 16px; text-decoration: none;">← Quay lại danh sách người dùng</a>
</div>

<div class="custom-card" style="max-width: 760px; margin: 0 auto;">
    <div style="border-bottom: 1px solid #e2e8f0; padding-bottom: 15px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h3 style="margin: 0; font-size: 1.35rem; color: #0f172a;">Thêm Người Dùng Mới</h3>
            <p style="margin: 4px 0 0 0; font-size: 0.85rem; color: #64748b;">Hệ thống trường THPT (Khối 10, 11, 12) - Tự động sinh Mã số, Tên đăng nhập và Email chuẩn</p>
        </div>
    </div>

    <form asp-action="CreateUser" method="post" id="createUserForm">
        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 15px; font-size: 0.9rem;"></div>

        <!-- 1. VAI TRÒ HỆ THỐNG -->
        <div class="form-group" style="margin-bottom: 20px;">
            <label asp-for="Role" class="form-label" style="font-weight: 600;">Vai trò trong hệ thống <span class="text-danger">*</span></label>
            <select asp-for="Role" id="roleSelect" class="form-control" style="font-size: 0.95rem; font-weight: 500; border: 2px solid #cbd5e1;" required>
                <option value="Student">Học sinh (Student - Khối 10, 11, 12)</option>
                <option value="Teacher">Giáo viên (Teacher)</option>
                <option value="Admin">Quản trị viên (Admin)</option>
            </select>
            <span asp-validation-for="Role" class="text-danger" style="font-size: 0.8rem;"></span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <!-- Họ và tên -->
            <div class="form-group">
                <label asp-for="FullName" class="form-label">Họ và Tên <span class="text-danger">*</span></label>
                <input asp-for="FullName" id="fullNameInput" class="form-control" placeholder="Ví dụ: Nguyễn Văn An" required />
                <span asp-validation-for="FullName" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <!-- Mã số định danh -->
            <div class="form-group">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <label asp-for="UserCode" class="form-label" style="margin-bottom: 0;">Mã số (Học sinh / Giáo viên) <span class="text-danger">*</span></label>
                    <button type="button" id="btnAutoCode" class="btn btn-sm btn-outline-secondary" style="font-size: 0.75rem; padding: 2px 8px; border-radius: 4px; cursor: pointer;">
                        🔄 Tự sinh mã
                    </button>
                </div>
                <input asp-for="UserCode" id="userCodeInput" class="form-control" placeholder="Ví dụ: STU021, TEA010" required />
                <span id="userCodeFeedback" style="font-size: 0.8rem; display: block; margin-top: 3px;"></span>
                <span asp-validation-for="UserCode" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <!-- Tên đăng nhập -->
            <div class="form-group">
                <label asp-for="Username" class="form-label">Tên tài khoản đăng nhập <span class="text-danger">*</span></label>
                <input asp-for="Username" id="usernameInput" class="form-control" placeholder="Ví dụ: an.nguyenvan" required />
                <span id="usernameFeedback" style="font-size: 0.8rem; display: block; margin-top: 3px;"></span>
                <span asp-validation-for="Username" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <!-- Email -->
            <div class="form-group">
                <label asp-for="Email" class="form-label">Địa chỉ Email <span class="text-danger">*</span></label>
                <input asp-for="Email" id="emailInput" type="email" class="form-control" placeholder="an.nguyenvan@school.edu.vn" required />
                <span id="emailFeedback" style="font-size: 0.8rem; display: block; margin-top: 3px;"></span>
                <span asp-validation-for="Email" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <!-- Mật khẩu -->
            <div class="form-group">
                <label asp-for="Password" class="form-label">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự" value="12345678" required />
                <span asp-validation-for="Password" class="text-danger" style="font-size: 0.8rem;"></span>
                <small class="text-muted" style="font-size: 0.75rem;">Mặc định: <code>12345678</code></small>
            </div>

            <!-- Giới tính -->
            <div class="form-group">
                <label asp-for="Gender" class="form-label">Giới tính <span class="text-danger">*</span></label>
                <select asp-for="Gender" class="form-control" required>
                    <option value="0">Nam</option>
                    <option value="1">Nữ</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <!-- Ngày sinh -->
            <div class="form-group">
                <label asp-for="DateOfBirth" class="form-label">Ngày sinh <span class="text-danger">*</span></label>
                <input asp-for="DateOfBirth" id="dateOfBirthInput" class="form-control" type="date" required />
                <span id="dobFeedback" style="font-size: 0.8rem; display: block; margin-top: 3px;"></span>
                <span asp-validation-for="DateOfBirth" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <!-- Số điện thoại -->
            <div class="form-group">
                <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                <input asp-for="PhoneNumber" id="phoneInput" class="form-control" placeholder="Ví dụ: 0912345678" />
                <span id="phoneFeedback" style="font-size: 0.8rem; display: block; margin-top: 3px;"></span>
                <span asp-validation-for="PhoneNumber" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Address" class="form-label">Địa chỉ thường trú</label>
            <input asp-for="Address" class="form-control" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố" />
            <span asp-validation-for="Address" class="text-danger" style="font-size: 0.8rem;"></span>
        </div>

        <!-- ================= STUDENT FIELDS ================= -->
        <div id="studentFields" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 15px; margin-top: 10px; margin-bottom: 20px;">
            <h4 style="margin-top: 0; margin-bottom: 10px; color: #0f172a; font-size: 0.95rem; display: flex; align-items: center; gap: 8px;">
                🎒 <span>Thông Tin Học Sinh Cấp 3 (Khối 10, 11, 12)</span>
            </h4>
            <div class="alert alert-info" style="margin-bottom: 0; font-size: 0.85rem; padding: 10px; border-radius: 6px; border-left: 4px solid #3b82f6; background-color: #eff6ff; color: #1e3a8a;">
                <strong>Lưu ý:</strong> Học sinh mới tạo sẽ có trạng thái <code>Active</code>. Việc xếp lớp chính thức cho học sinh (Khối 10, 11, 12) được thực hiện tại giao diện <strong>Quản lý lớp học</strong> (Chi tiết Lớp -> Xếp học sinh vào lớp).
            </div>
        </div>

        <!-- ================= TEACHER FIELDS ================= -->
        <div id="teacherFields" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 15px; margin-top: 10px; margin-bottom: 20px; display: none;">
            <h4 style="margin-top: 0; margin-bottom: 12px; color: #0f172a; font-size: 0.95rem; display: flex; align-items: center; gap: 8px;">
                👨‍ <span>Hồ Sơ Giáo Viên</span>
            </h4>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
                <div class="form-group" style="margin-bottom: 0;">
                    <label asp-for="AcademicDegree" class="form-label">Trình độ / Bằng cấp</label>
                    <input asp-for="AcademicDegree" class="form-control" placeholder="Ví dụ: Cử nhân sư phạm, Thạc sĩ" />
                </div>
                <div class="form-group" style="margin-bottom: 0;">
                    <label asp-for="Specialization" class="form-label">Chuyên môn giảng dạy</label>
                    <input asp-for="Specialization" class="form-control" placeholder="Ví dụ: Toán học, Ngữ văn, Vật lý, Hóa học" />
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                <div class="form-group" style="margin-bottom: 0;">
                    <label asp-for="Department" class="form-label">Tổ bộ môn</label>
                    <input asp-for="Department" class="form-control" placeholder="Ví dụ: Tổ Tự nhiên, Tổ Xã hội, Tổ Ngoại ngữ" />
                </div>
                <div class="form-group" style="margin-bottom: 0;">
                    <label asp-for="HireDate" class="form-label">Ngày nhận công tác</label>
                    <input asp-for="HireDate" id="hireDateInput" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span id="hireDateFeedback" style="font-size: 0.8rem; display: block; margin-top: 3px;"></span>
                </div>
            </div>
        </div>

        <div style="display: flex; gap: 12px; margin-top: 25px;">
            <button type="submit" id="btnSubmit" class="btn btn-primary" style="flex: 1; padding: 12px; font-weight: 600;">
                ✓ Thêm mới người dùng
            </button>
            <a asp-action="Users" class="btn btn-secondary" style="flex: 1; padding: 12px; text-align: center; text-decoration: none;">
                Hủy
            </a>
        </div>
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const roleSelect = document.getElementById("roleSelect");
        const studentFields = document.getElementById("studentFields");
        const teacherFields = document.getElementById("teacherFields");
        const fullNameInput = document.getElementById("fullNameInput");
        const userCodeInput = document.getElementById("userCodeInput");
        const usernameInput = document.getElementById("usernameInput");
        const emailInput = document.getElementById("emailInput");
        const dateOfBirthInput = document.getElementById("dateOfBirthInput");
        const hireDateInput = document.getElementById("hireDateInput");
        const phoneInput = document.getElementById("phoneInput");
        const btnAutoCode = document.getElementById("btnAutoCode");

        let userManuallyEditedUsername = false;
        let userManuallyEditedEmail = false;

        usernameInput.addEventListener("input", () => { userManuallyEditedUsername = true; });
        emailInput.addEventListener("input", () => { userManuallyEditedEmail = true; });

        // Utility: Convert Vietnamese accents to English slug
        function removeVietnameseTones(str) {
            str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, "a");
            str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, "e");
            str = str.replace(/ì|í|ị|ỉ|ĩ/g, "i");
            str = str.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, "o");
            str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, "u");
            str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, "y");
            str = str.replace(/đ/g, "d");
            str = str.replace(/À|Á|Ạ|Ả|Ã|Â|Ầ|Ấ|Ậ|Ẩ|Ẫ|Ă|Ằ|Ắ|Ặ|Ẳ|Ẵ/g, "a");
            str = str.replace(/È|É|Ẹ|Ẻ|Ẽ|Ê|Ề|Ế|Ệ|Ể|Ễ/g, "e");
            str = str.replace(/Ì|Í|Ị|Ỉ|Ĩ/g, "i");
            str = str.replace(/Ò|Ó|Ọ|Ỏ|Õ|Ô|Ồ|Ố|Ộ|Ổ|Ỗ|Ơ|Ờ|Ớ|Ợ|Ở|Ỡ/g, "o");
            str = str.replace(/Ù|Ú|Ụ|Ủ|Ũ|Ư|Ừ|Ứ|Ự|Ử|Ữ/g, "u");
            str = str.replace(/Ỳ|Ý|Ỵ|Ỷ|Ỹ/g, "y");
            str = str.replace(/Đ/g, "d");
            str = str.replace(/[^a-zA-Z0-9 ]/g, "");
            return str.toLowerCase().trim();
        }

        // Auto-generate username from FullName
        function generateUsername(fullName, role) {
            const clean = removeVietnameseTones(fullName);
            const parts = clean.split(/\s+/).filter(Boolean);
            if (parts.length === 0) return "";
            if (parts.length === 1) return parts[0];

            const lastName = parts[parts.length - 1];
            const otherNames = parts.slice(0, parts.length - 1).join("");
            return `${lastName}.${otherNames}`;
        }

        // Suggest code from server
        async function fetchNextUserCode(role) {
            try {
                const res = await fetch(`/Admin/GetNextUserCode?role=${encodeURIComponent(role)}`);
                if (res.ok) {
                    const data = await res.json();
                    if (data.userCode) {
                        userCodeInput.value = data.userCode;
                        checkUniqueField("userCode", data.userCode);
                    }
                }
            } catch (err) {
                console.error("Failed to fetch next user code", err);
            }
        }

        // Toggle UI & Date constraints by role
        function updateRoleUI() {
            const role = roleSelect.value;
            const today = new Date();
            const yyyy = today.getFullYear();
            const mm = String(today.getMonth() + 1).padStart(2, '0');
            const dd = String(today.getDate()).padStart(2, '0');
            const todayStr = `${yyyy}-${mm}-${dd}`;

            if (role === "Student") {
                studentFields.style.display = "block";
                teacherFields.style.display = "none";
                
                // Học sinh cấp 3 (Khối 10, 11, 12): 14 -> 20 tuổi
                const maxDob = new Date(today.getFullYear() - 14, today.getMonth(), today.getDate()).toISOString().split('T')[0];
                const minDob = new Date(today.getFullYear() - 20, today.getMonth(), today.getDate()).toISOString().split('T')[0];
                dateOfBirthInput.max = maxDob;
                dateOfBirthInput.min = minDob;
                if (!dateOfBirthInput.value || dateOfBirthInput.value > maxDob || dateOfBirthInput.value < minDob) {
                    dateOfBirthInput.value = new Date(today.getFullYear() - 16, 0, 1).toISOString().split('T')[0];
                }
            } else if (role === "Teacher") {
                studentFields.style.display = "none";
                teacherFields.style.display = "block";
                
                // Giáo viên: >= 21 tuổi
                const maxDob = new Date(today.getFullYear() - 21, today.getMonth(), today.getDate()).toISOString().split('T')[0];
                dateOfBirthInput.max = maxDob;
                dateOfBirthInput.min = "1950-01-01";
                if (!dateOfBirthInput.value || dateOfBirthInput.value > maxDob) {
                    dateOfBirthInput.value = new Date(today.getFullYear() - 28, 0, 1).toISOString().split('T')[0];
                }
                hireDateInput.max = todayStr;
            } else {
                studentFields.style.display = "none";
                teacherFields.style.display = "none";
                
                // Admin: >= 18 tuổi
                const maxDob = new Date(today.getFullYear() - 18, today.getMonth(), today.getDate()).toISOString().split('T')[0];
                dateOfBirthInput.max = maxDob;
                dateOfBirthInput.min = "1950-01-01";
            }
        }

        // On Full Name change -> generate username & email
        fullNameInput.addEventListener("input", function () {
            const name = this.value;
            const role = roleSelect.value;
            const suggestedUser = generateUsername(name, role);

            if (!userManuallyEditedUsername && suggestedUser) {
                usernameInput.value = suggestedUser;
                checkUniqueField("username", suggestedUser);
            }

            if (!userManuallyEditedEmail && suggestedUser) {
                emailInput.value = `${suggestedUser}@@school.edu.vn`;
                checkUniqueField("email", emailInput.value);
            }
        });

        // On Role change
        roleSelect.addEventListener("change", function () {
            updateRoleUI();
            fetchNextUserCode(this.value);
        });

        btnAutoCode.addEventListener("click", function () {
            fetchNextUserCode(roleSelect.value);
        });

        // Realtime Unique validation via blur
        async function checkUniqueField(field, value) {
            if (!value || !value.trim()) return;

            let query = "";
            if (field === "userCode") query = `userCode=${encodeURIComponent(value.trim())}`;
            else if (field === "username") query = `username=${encodeURIComponent(value.trim())}`;
            else if (field === "email") query = `email=${encodeURIComponent(value.trim())}`;
            else if (field === "phone") query = `phoneNumber=${encodeURIComponent(value.trim())}`;

            try {
                const res = await fetch(`/Admin/CheckUnique?${query}`);
                if (res.ok) {
                    const data = await res.json();
                    if (field === "userCode") {
                        const el = document.getElementById("userCodeFeedback");
                        if (data.isUserCodeTaken) {
                            el.innerHTML = `<span style="color: #ef4444;"> Mã số "${value}" đã tồn tại trên hệ thống!</span>`;
                        } else {
                            el.innerHTML = `<span style="color: #10b981;">✓ Mã số hợp lệ</span>`;
                        }
                    } else if (field === "username") {
                        const el = document.getElementById("usernameFeedback");
                        if (data.isUsernameTaken) {
                            el.innerHTML = `<span style="color: #ef4444;"> Tên đăng nhập "${value}" đã được sử dụng!</span>`;
                        } else {
                            el.innerHTML = `<span style="color: #10b981;">✓ Tên đăng nhập hợp lệ</span>`;
                        }
                    } else if (field === "email") {
                        const el = document.getElementById("emailFeedback");
                        if (data.isEmailTaken) {
                            el.innerHTML = `<span style="color: #ef4444;"> Email "${value}" đã được đăng ký!</span>`;
                        } else {
                            el.innerHTML = `<span style="color: #10b981;">✓ Email hợp lệ</span>`;
                        }
                    } else if (field === "phone") {
                        const el = document.getElementById("phoneFeedback");
                        if (data.isPhoneTaken) {
                            el.innerHTML = `<span style="color: #ef4444;"> Số điện thoại "${value}" đã tồn tại!</span>`;
                        } else {
                            el.innerHTML = `<span style="color: #10b981;">✓ Số điện thoại hợp lệ</span>`;
                        }
                    }
                }
            } catch (err) {
                console.error("Unique check failed", err);
            }
        }

        userCodeInput.addEventListener("blur", function () { checkUniqueField("userCode", this.value); });
        usernameInput.addEventListener("blur", function () { checkUniqueField("username", this.value); });
        emailInput.addEventListener("blur", function () { checkUniqueField("email", this.value); });
        phoneInput.addEventListener("blur", function () { checkUniqueField("phone", this.value); });

        // Initial setup
        updateRoleUI();
        if (!userCodeInput.value) {
            fetchNextUserCode(roleSelect.value);
        }
    });
</script>
