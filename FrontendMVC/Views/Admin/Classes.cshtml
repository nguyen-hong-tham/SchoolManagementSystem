@model IEnumerable<ClassViewModel>
@{
    ViewData["Title"] = "Quản Lý Lớp Học";
    Layout = "_Layout";
    var searchValue = ViewBag.Search as string;
    var currentYearFilter = ViewBag.SchoolYearFilter as string;
    var allYears = ViewBag.AllSchoolYears as List<string> ?? new List<string>();
    var gradeFilter = ViewBag.GradeFilter as int?;
    var totalClasses = Model?.Count() ?? 0;
}

<div class="custom-card" style="padding: 24px; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
    <!-- Header Section -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 15px;">
        <div>
            <h2 style="font-size: 1.4rem; font-weight: 700; color: #0f172a; margin-bottom: 4px; display: flex; align-items: center; gap: 10px;">
                <span></span> Danh Sách Lớp Học
                <span class="badge" style="background-color: #e0e7ff; color: #4338ca; font-size: 0.85rem; font-weight: 600; padding: 4px 10px; border-radius: 20px;">
                    Tổng: <span id="totalClassCount">@totalClasses</span> lớp
                </span>
            </h2>
            <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 0;">Quản lý danh sách lớp học, giáo viên chủ nhiệm và phân bổ sĩ số theo từng năm học</p>
        </div>

        <a asp-action="CreateClass" class="btn btn-primary" style="padding: 10px 22px; font-weight: 600; border-radius: 8px; box-shadow: 0 2px 8px rgba(79, 70, 229, 0.25); text-decoration: none; display: flex; align-items: center; gap: 8px;">
            <span></span> Thêm Lớp Học Mới
        </a>
    </div>

    <!-- Filter & Search Toolbar -->
    <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px; margin-bottom: 20px;">
        <form asp-action="Classes" method="get" id="classFilterForm" style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
            
            <!-- Lọc Năm Học -->
            <div style="display: flex; align-items: center; gap: 8px;">
                <label style="font-size: 0.85rem; font-weight: 600; color: #475569; white-space: nowrap; margin-bottom: 0;"> Năm học:</label>
                <select name="schoolYear" class="form-control" onchange="this.form.submit()" style="min-width: 150px; padding: 8px 12px; border-radius: 8px; border-color: #cbd5e1; font-weight: 500;">
                    @if (allYears.Any())
                    {
                        @foreach (var y in allYears)
                        {
                            <option value="@y" selected="@(currentYearFilter == y)">Năm học @y</option>
                        }
                    }
                    else
                    {
                        <option value="2025-2026" selected="@(currentYearFilter == "2025-2026")">Năm học 2025-2026</option>
                    }
                    <option value="all" selected="@(currentYearFilter == "all")">-- Tất cả năm học --</option>
                </select>
            </div>

            <!-- Lọc Khối -->
            <div style="display: flex; align-items: center; gap: 8px;">
                <label style="font-size: 0.85rem; font-weight: 600; color: #475569; white-space: nowrap; margin-bottom: 0;"> Khối:</label>
                <select name="grade" class="form-control" onchange="this.form.submit()" style="min-width: 130px; padding: 8px 12px; border-radius: 8px; border-color: #cbd5e1;">
                    <option value="">-- Tất cả khối --</option>
                    <option value="10" selected="@(gradeFilter == 10)">Khối 10</option>
                    <option value="11" selected="@(gradeFilter == 11)">Khối 11</option>
                    <option value="12" selected="@(gradeFilter == 12)">Khối 12</option>
                </select>
            </div>

            <!-- Tìm kiếm -->
            <div style="flex: 1; min-width: 220px;">
                <input type="text" name="search" class="form-control" placeholder="Tìm theo tên lớp, tên hoặc mã GVCN..." value="@searchValue" style="width: 100%; padding: 8px 14px; border-radius: 8px; border-color: #cbd5e1;" />
            </div>

            <button type="submit" class="btn btn-secondary" style="padding: 8px 18px; font-weight: 600; border-radius: 8px;">
                 Tìm kiếm
            </button>

            @if (!string.IsNullOrEmpty(searchValue) || gradeFilter.HasValue || (!string.IsNullOrEmpty(currentYearFilter) && currentYearFilter != (allYears.FirstOrDefault() ?? "2025-2026")))
            {
                <a asp-action="Classes" class="btn btn-outline-secondary" style="padding: 8px 16px; border-radius: 8px; text-decoration: none; display: flex; align-items: center; gap: 5px;">
                    ✕ Xóa lọc
                </a>
            }
        </form>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="border-radius: 8px; margin-bottom: 16px;">
             @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="border-radius: 8px; margin-bottom: 16px;">
             @TempData["ErrorMessage"]
        </div>
    }

    <!-- Classes Table -->
    <div class="table-responsive" style="border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 16px;">
        <table class="custom-table" id="classesDataTable" style="margin-bottom: 0;">
            <thead style="background-color: #f1f5f9;">
                <tr>
                    <th style="width: 50px; text-align: center;">STT</th>
                    <th style="min-width: 140px;">Tên Lớp</th>
                    <th style="width: 100px; text-align: center;">Khối</th>
                    <th style="min-width: 120px; text-align: center;">Năm Học</th>
                    <th style="min-width: 220px;">Giáo Viên Chủ Nhiệm</th>
                    <th style="min-width: 150px; text-align: center;">Sĩ Số</th>
                    <th style="text-align: right; width: 220px;">Hành Động</th>
                </tr>
            </thead>
            <tbody id="classesTableBody">
                @if (Model == null || !Model.Any())
                {
                    <tr id="emptyRow">
                        <td colspan="7" class="text-center text-muted" style="padding: 40px 0;">
                            <div style="font-size: 2rem; margin-bottom: 8px;"></div>
                            <div style="font-weight: 500;">Không tìm thấy lớp học nào phù hợp với bộ lọc.</div>
                        </td>
                    </tr>
                }
                else
                {
                    int index = 1;
                    @foreach (var item in Model)
                    {
                        var studentCount = item.CurrentStudentCount;
                        var capacity = item.Capacity > 0 ? item.Capacity : 45;
                        var isFull = studentCount >= capacity;
                        var hasStudents = studentCount > 0;

                        <tr class="class-data-row" data-index="@index" data-class-id="@item.Id" data-student-count="@studentCount" data-class-name="@item.Name">
                            <td style="text-align: center; font-weight: 600; color: #64748b;" class="row-stt">@(index++)</td>
                            
                            <!-- Tên lớp -->
                            <td>
                                <a asp-action="ClassDetail" asp-route-id="@item.Id" style="font-weight: 700; font-size: 1.05rem; color: #1e293b; text-decoration: none; display: flex; align-items: center; gap: 8px;">
                                    <span style="display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 8px; background-color: #ede9fe; color: #6366f1; font-size: 0.9rem;"></span>
                                    <span>Lớp @item.Name</span>
                                </a>
                            </td>

                            <!-- Khối -->
                            <td style="text-align: center;">
                                @if (item.GradeLevel == 10)
                                {
                                    <span class="badge" style="background-color: #e0f2fe; color: #0369a1; font-weight: 600; padding: 5px 10px; border-radius: 6px;">Khối 10</span>
                                }
                                else if (item.GradeLevel == 11)
                                {
                                    <span class="badge" style="background-color: #fef3c7; color: #b45309; font-weight: 600; padding: 5px 10px; border-radius: 6px;">Khối 11</span>
                                }
                                else
                                {
                                    <span class="badge" style="background-color: #fce7f3; color: #be185d; font-weight: 600; padding: 5px 10px; border-radius: 6px;">Khối 12</span>
                                }
                            </td>

                            <!-- Năm học -->
                            <td style="text-align: center;">
                                <span class="badge" style="background-color: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; font-weight: 600; padding: 5px 10px; border-radius: 6px;">
                                    @item.SchoolYear
                                </span>
                            </td>

                            <!-- GVCN -->
                            <td>
                                @if (!string.IsNullOrEmpty(item.HomeroomTeacherName))
                                {
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <span style="width: 28px; height: 28px; border-radius: 50%; background-color: #e0e7ff; color: #4338ca; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700;">
                                            GV
                                        </span>
                                        <div>
                                            <div style="font-weight: 600; color: #1e293b; font-size: 0.92rem;">@item.HomeroomTeacherName</div>
                                            <div style="color: #64748b; font-size: 0.78rem;">Mã GV: @item.HomeroomTeacherCode</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge" style="background-color: #fff7ed; color: #c2410c; border: 1px dashed #fdba74; font-weight: 500; padding: 5px 10px; border-radius: 6px;">
                                         Chưa phân công
                                    </span>
                                }
                            </td>

                            <!-- Sĩ số -->
                            <td style="text-align: center;">
                                <div style="display: inline-flex; flex-direction: column; align-items: center;">
                                    <span class="badge @(isFull ? "bg-danger text-white" : hasStudents ? "bg-success text-white" : "bg-light text-muted border")" style="font-size: 0.85rem; padding: 5px 12px; border-radius: 20px; font-weight: 600;">
                                         @studentCount / @capacity HS
                                    </span>
                                </div>
                            </td>

                            <!-- Hành động -->
                            <td>
                                <div style="display: flex; justify-content: flex-end; gap: 6px;">
                                    <a asp-action="ClassDetail" asp-route-id="@item.Id" class="btn btn-secondary" style="padding: 6px 12px; font-size: 0.85rem; font-weight: 500; text-decoration: none; border-radius: 6px;" title="Xem chi tiết lớp, danh sách học sinh và thời khóa biểu">
                                         Chi tiết
                                    </a>
                                    <a asp-action="EditClass" asp-route-id="@item.Id" class="btn btn-secondary" style="padding: 6px 10px; font-size: 0.85rem; font-weight: 500; text-decoration: none; color: #4f46e5; border-color: #c7d2fe; border-radius: 6px;" title="Chỉnh sửa thông tin lớp">
                                         Sửa
                                    </a>
                                    
                                    @if (hasStudents)
                                    {
                                        <!-- Nút Xóa có cảnh báo ràng buộc -->
                                        <button type="button" class="btn btn-outline-danger" style="padding: 6px 10px; font-size: 0.85rem; border-radius: 6px;" onclick="showDeleteWarningModal('@item.Name', @studentCount)" title="Lớp đã có học sinh, không thể xóa trực tiếp">
                                            ️ Xóa
                                        </button>
                                    }
                                    else
                                    {
                                        <!-- Nút Xóa an toàn -->
                                        <button type="button" class="btn btn-danger" style="padding: 6px 10px; font-size: 0.85rem; border-radius: 6px;" onclick="confirmDeleteClass('@item.Id', '@item.Name')" title="Xóa lớp học">
                                            ️ Xóa
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; padding-top: 8px;">
        <div style="color: #64748b; font-size: 0.88rem; display: flex; align-items: center; gap: 10px;">
            <span id="paginationInfo">Hiển thị 0 - 0 trong tổng số 0 lớp học</span>
            <div style="display: inline-flex; align-items: center; gap: 6px;">
                <label style="margin-bottom: 0; font-size: 0.82rem; color: #94a3b8;">Số dòng/trang:</label>
                <select id="pageSizeSelect" class="form-select form-select-sm" style="width: auto; display: inline-block; padding: 2px 24px 2px 8px; font-size: 0.85rem; border-radius: 6px; border-color: #cbd5e1;">
                    <option value="10" selected>10</option>
                    <option value="15">15</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
        </div>

        <nav aria-label="Classes pagination">
            <ul class="pagination pagination-sm mb-0" id="paginationControls" style="display: flex; gap: 4px; list-style: none; margin: 0; padding: 0;">
                <!-- Generated by JavaScript -->
            </ul>
        </nav>
    </div>
</div>

<!-- Modal Cảnh Báo Ràng Buộc Khi Xóa Lớp Đã Có Học Sinh -->
<div id="deleteWarningModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 9999; justify-content: center; align-items: center;">
    <div style="background: white; border-radius: 12px; width: 100%; max-width: 480px; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); margin: 20px;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="width: 44px; height: 44px; border-radius: 50%; background-color: #fee2e2; color: #dc2626; display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
                
            </div>
            <div>
                <h4 style="font-size: 1.15rem; font-weight: 700; color: #0f172a; margin-bottom: 2px;">Không Thể Xóa Lớp Học</h4>
                <div style="font-size: 0.85rem; color: #64748b;">Ràng buộc toàn vẹn dữ liệu học sinh</div>
            </div>
        </div>

        <div style="background-color: #fff7ed; border-left: 4px solid #f97316; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px; font-size: 0.9rem; color: #9a3412;">
            Lớp <strong id="warningClassName" style="color: #c2410c;">10A1</strong> hiện đang có <strong id="warningStudentCount">7</strong> học sinh theo học.
        </div>

        <p style="font-size: 0.9rem; color: #475569; line-height: 1.5; margin-bottom: 20px;">
            Để đảm bảo không bị mất hồ sơ học tập và dữ liệu điểm số, hệ thống <strong>chặn hành động xóa</strong> lớp học này. Vui lòng chuyển hoặc xóa hết học sinh trong lớp trước khi thực hiện thao tác xóa.
        </p>

        <div style="display: flex; justify-content: flex-end; gap: 10px;">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteWarningModal()" style="padding: 8px 18px; font-weight: 600; border-radius: 8px;">
                Đã hiểu
            </button>
        </div>
    </div>
</div>

<!-- Form Xóa Ẩn Cho Action DeleteClass -->
<form id="deleteClassForm" asp-action="DeleteClass" method="post" style="display:none;">
    <input type="hidden" name="id" id="deleteClassIdInput" />
</form>

<!-- Modal Xác Nhận Xóa Lớp Trống -->
<div id="deleteConfirmModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 9999; justify-content: center; align-items: center;">
    <div style="background: white; border-radius: 12px; width: 100%; max-width: 440px; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); margin: 20px;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="width: 44px; height: 44px; border-radius: 50%; background-color: #fee2e2; color: #dc2626; display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
                ️
            </div>
            <div>
                <h4 style="font-size: 1.15rem; font-weight: 700; color: #0f172a; margin-bottom: 2px;">Xác Nhận Xóa Lớp</h4>
                <div style="font-size: 0.85rem; color: #64748b;">Thao tác này không thể hoàn tác</div>
            </div>
        </div>

        <p style="font-size: 0.92rem; color: #475569; line-height: 1.5; margin-bottom: 20px;">
            Bạn có chắc chắn muốn xóa lớp <strong id="confirmClassName" style="color: #0f172a;">10A1</strong>?
        </p>

        <div style="display: flex; justify-content: flex-end; gap: 10px;">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteConfirmModal()" style="padding: 8px 16px; border-radius: 8px;">
                Hủy bỏ
            </button>
            <button type="button" class="btn btn-danger" onclick="submitDeleteClass()" style="padding: 8px 18px; font-weight: 600; border-radius: 8px;">
                Xác nhận xóa
            </button>
        </div>
    </div>
</div>

<script>
    // Client-side Pagination Logic
    let currentPage = 1;
    let pageSize = 10;
    const allRows = Array.from(document.querySelectorAll('.class-data-row'));

    function renderPagination() {
        const totalItems = allRows.length;
        const totalPages = Math.ceil(totalItems / pageSize) || 1;

        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        const startIndex = (currentPage - 1) * pageSize;
        const endIndex = Math.min(startIndex + pageSize, totalItems);

        // Hide all rows, show current page rows
        allRows.forEach((row, i) => {
            if (i >= startIndex && i < endIndex) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });

        // Update info text
        const infoEl = document.getElementById('paginationInfo');
        if (infoEl) {
            if (totalItems === 0) {
                infoEl.innerText = 'Hiển thị 0 trong tổng số 0 lớp học';
            } else {
                infoEl.innerText = `Hiển thị ${startIndex + 1} - ${endIndex} trong tổng số ${totalItems} lớp học`;
            }
        }

        // Build pagination controls
        const controls = document.getElementById('paginationControls');
        if (!controls) return;
        controls.innerHTML = '';

        if (totalPages <= 1) return;

        // Button Previous
        const prevLi = document.createElement('li');
        prevLi.className = `page-item ${currentPage === 1 ? 'disabled' : ''}`;
        prevLi.innerHTML = `<button type="button" class="page-link" style="padding: 6px 12px; border-radius: 6px; border: 1px solid #cbd5e1; background: ${currentPage === 1 ? '#f1f5f9' : '#fff'}; color: ${currentPage === 1 ? '#94a3b8' : '#334155'}; font-weight: 500;">‹ Trước</button>`;
        if (currentPage > 1) {
            prevLi.querySelector('button').addEventListener('click', () => {
                currentPage--;
                renderPagination();
            });
        }
        controls.appendChild(prevLi);

        // Page Numbers
        for (let p = 1; p <= totalPages; p++) {
            if (totalPages > 7) {
                // Show pagination ellipsis for large number of pages
                if (p !== 1 && p !== totalPages && Math.abs(p - currentPage) > 2) {
                    if (p === 2 || p === totalPages - 1) {
                        const dotsLi = document.createElement('li');
                        dotsLi.className = 'page-item disabled';
                        dotsLi.innerHTML = `<span class="page-link" style="padding: 6px 10px; border: none; background: transparent; color: #94a3b8;">...</span>`;
                        controls.appendChild(dotsLi);
                    }
                    continue;
                }
            }

            const pLi = document.createElement('li');
            const isActive = p === currentPage;
            pLi.className = `page-item ${isActive ? 'active' : ''}`;
            pLi.innerHTML = `<button type="button" class="page-link" style="padding: 6px 12px; border-radius: 6px; border: 1px solid ${isActive ? '#4f46e5' : '#cbd5e1'}; background: ${isActive ? '#4f46e5' : '#fff'}; color: ${isActive ? '#fff' : '#334155'}; font-weight: ${isActive ? '700' : '500'};">${p}</button>`;
            
            pLi.querySelector('button').addEventListener('click', () => {
                currentPage = p;
                renderPagination();
            });
            controls.appendChild(pLi);
        }

        // Button Next
        const nextLi = document.createElement('li');
        nextLi.className = `page-item ${currentPage === totalPages ? 'disabled' : ''}`;
        nextLi.innerHTML = `<button type="button" class="page-link" style="padding: 6px 12px; border-radius: 6px; border: 1px solid #cbd5e1; background: ${currentPage === totalPages ? '#f1f5f9' : '#fff'}; color: ${currentPage === totalPages ? '#94a3b8' : '#334155'}; font-weight: 500;">Tiếp ›</button>`;
        if (currentPage < totalPages) {
            nextLi.querySelector('button').addEventListener('click', () => {
                currentPage++;
                renderPagination();
            });
        }
        controls.appendChild(nextLi);
    }

    document.getElementById('pageSizeSelect')?.addEventListener('change', function () {
        pageSize = parseInt(this.value, 10);
        currentPage = 1;
        renderPagination();
    });

    // Delete Constraint Modals
    function showDeleteWarningModal(className, studentCount) {
        document.getElementById('warningClassName').innerText = className;
        document.getElementById('warningStudentCount').innerText = studentCount;
        const modal = document.getElementById('deleteWarningModal');
        modal.style.display = 'flex';
    }

    function closeDeleteWarningModal() {
        document.getElementById('deleteWarningModal').style.display = 'none';
    }

    let targetDeleteClassId = null;
    function confirmDeleteClass(classId, className) {
        targetDeleteClassId = classId;
        document.getElementById('confirmClassName').innerText = className;
        const modal = document.getElementById('deleteConfirmModal');
        modal.style.display = 'flex';
    }

    function closeDeleteConfirmModal() {
        targetDeleteClassId = null;
        document.getElementById('deleteConfirmModal').style.display = 'none';
    }

    function submitDeleteClass() {
        if (!targetDeleteClassId) return;
        document.getElementById('deleteClassIdInput').value = targetDeleteClassId;
        document.getElementById('deleteClassForm').submit();
    }

    // Close modals on escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeDeleteWarningModal();
            closeDeleteConfirmModal();
        }
    });

    // Initial render
    document.addEventListener('DOMContentLoaded', () => {
        renderPagination();
    });
</script>
