@model UpdateUserRequest
@{
    ViewData["Title"] = "Chỉnh Sửa Người Dùng";
    Layout = "_Layout";
    var userId = ViewBag.UserId as Guid?;
    var username = ViewBag.Username as string;
    var role = ViewBag.Role as string; // "Admin", "Teacher", "Student"
    var classes = ViewBag.Classes as IEnumerable<ClassViewModel> ?? new List<ClassViewModel>();
}

<div class="mb-3">
    <a asp-action="Users" class="btn btn-secondary" style="padding: 8px 16px; text-decoration: none;">← Quay lại danh sách người dùng</a>
</div>

<div class="custom-card" style="max-width: 760px; margin: 0 auto;">
    <h3 style="margin-bottom: 20px; border-bottom: 1px solid #e2e8f0; padding-bottom: 10px;">Chỉnh Sửa Thông Tin Người Dùng</h3>

    <form asp-action="EditUser" asp-route-id="@userId" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 15px; font-size: 0.9rem;"></div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <!-- Tài khoản đăng nhập (Readonly) -->
            <div class="form-group">
                <label class="form-label">Tên tài khoản</label>
                <input class="form-control" value="@username" readonly style="background-color: #f1f5f9; color: #64748b; cursor: not-allowed;" />
            </div>

            <!-- Vai trò (Readonly) -->
            <div class="form-group">
                <label class="form-label">Vai trò</label>
                <input class="form-control" value="@(role == "Admin" ? "Quản trị viên" : role == "Teacher" ? "Giáo viên" : "Học sinh")" readonly style="background-color: #f1f5f9; color: #64748b; cursor: not-allowed;" />
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <!-- Mã số định danh -->
            <div class="form-group">
                <label asp-for="UserCode" class="form-label">Mã số (Học sinh / Giáo viên) <span class="text-danger">*</span></label>
                <input asp-for="UserCode" id="userCodeInput" class="form-control" placeholder="Mã định danh" required />
                <span id="userCodeFeedback" style="font-size: 0.8rem; display: block; margin-top: 3px;"></span>
                <span asp-validation-for="UserCode" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <!-- Họ và tên -->
            <div class="form-group">
                <label asp-for="FullName" class="form-label">Họ và Tên <span class="text-danger">*</span></label>
                <input asp-for="FullName" class="form-control" placeholder="Họ và tên đầy đủ" required />
                <span asp-validation-for="FullName" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <!-- Email -->
            <div class="form-group">
                <label asp-for="Email" class="form-label">Địa chỉ Email <span class="text-danger">*</span></label>
                <input asp-for="Email" id="emailInput" type="email" class="form-control" placeholder="name@school.edu.vn" required />
                <span id="emailFeedback" style="font-size: 0.8rem; display: block; margin-top: 3px;"></span>
                <span asp-validation-for="Email" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <!-- Giới tính -->
            <div class="form-group">
                <label asp-for="Gender" class="form-label">Giới tính <span class="text-danger">*</span></label>
                <select asp-for="Gender" class="form-control" required>
                    <option value="0">Nam</option>
                    <option value="1">Nữ</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <!-- Ngày sinh -->
            <div class="form-group">
                <label asp-for="DateOfBirth" class="form-label">Ngày sinh <span class="text-danger">*</span></label>
                <input asp-for="DateOfBirth" class="form-control" type="date" value="@Model.DateOfBirth.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                <span asp-validation-for="DateOfBirth" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <!-- Số điện thoại -->
            <div class="form-group">
                <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                <input asp-for="PhoneNumber" id="phoneInput" class="form-control" placeholder="Số điện thoại liên hệ" />
                <span id="phoneFeedback" style="font-size: 0.8rem; display: block; margin-top: 3px;"></span>
                <span asp-validation-for="PhoneNumber" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>
        </div>

        <!-- Địa chỉ -->
        <div class="form-group">
            <label asp-for="Address" class="form-label">Địa chỉ thường trú</label>
            <input asp-for="Address" class="form-control" placeholder="Địa chỉ hiện tại" />
            <span asp-validation-for="Address" class="text-danger" style="font-size: 0.8rem;"></span>
        </div>

        <!-- ================= STUDENT FIELDS ================= -->
        @if (role == "Student")
        {
            <div id="studentFields" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 15px; margin-top: 10px; margin-bottom: 20px;">
                <h4 style="margin-top: 0; margin-bottom: 12px; color: #0f172a; font-size: 0.95rem; display: flex; align-items: center; gap: 8px;">
                    🎒 <span>Thông Tin Học Sinh Cấp 3 (Khối 10, 11, 12)</span>
                </h4>
                <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label">Lớp học hiện tại</label>
                    <input type="hidden" asp-for="ClassId" />
                    @{
                        var currentClass = classes.FirstOrDefault(c => c.Id == Model.ClassId);
                    }
                    <input class="form-control" type="text" value="@(currentClass != null ? $"{currentClass.Name} ({currentClass.SchoolYear})" : "Chưa xếp lớp")" readonly style="background-color: #e2e8f0; cursor: not-allowed;" />
                    <span style="font-size: 0.8rem; color: #64748b; margin-top: 6px; display: inline-block;">
                        * Việc xếp lớp / chuyển lớp được quản lý qua phân hệ Quản lý Lớp học.
                    </span>
                </div>
            </div>
        }

        <!-- ================= TEACHER FIELDS ================= -->
        @if (role == "Teacher")
        {
            <div id="teacherFields" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 15px; margin-top: 10px; margin-bottom: 20px;">
                <h4 style="margin-top: 0; margin-bottom: 12px; color: #0f172a; font-size: 0.95rem; display: flex; align-items: center; gap: 8px;">
                    👨‍ <span>Hồ Sơ Giáo Viên</span>
                </h4>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
                    <div class="form-group" style="margin-bottom: 0;">
                        <label asp-for="AcademicDegree" class="form-label">Trình độ / Bằng cấp</label>
                        <input asp-for="AcademicDegree" class="form-control" placeholder="Ví dụ: Cử nhân sư phạm, Thạc sĩ" />
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label asp-for="Specialization" class="form-label">Chuyên môn giảng dạy</label>
                        <input asp-for="Specialization" class="form-control" placeholder="Ví dụ: Toán học, Ngữ văn" />
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <div class="form-group" style="margin-bottom: 0;">
                        <label asp-for="Department" class="form-label">Tổ bộ môn</label>
                        <input asp-for="Department" class="form-control" placeholder="Tổ Tự nhiên / Tổ Xã hội" />
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label asp-for="HireDate" class="form-label">Ngày nhận công tác</label>
                        <input asp-for="HireDate" class="form-control" type="date" value="@(Model.HireDate?.ToString("yyyy-MM-dd"))" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
            </div>
        }

        <div style="display: flex; gap: 12px; margin-top: 25px;">
            <button type="submit" class="btn btn-primary" style="flex: 1; padding: 12px; font-weight: 600;">Cập nhật thông tin</button>
            <a asp-action="Users" class="btn btn-secondary" style="flex: 1; padding: 12px; text-align: center; text-decoration: none;">Hủy</a>
        </div>
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const userId = "@userId";
        const userCodeInput = document.getElementById("userCodeInput");
        const emailInput = document.getElementById("emailInput");
        const phoneInput = document.getElementById("phoneInput");

        async function checkUnique(field, value) {
            if (!value || !value.trim()) return;
            let query = `excludeId=${encodeURIComponent(userId)}&`;
            if (field === "userCode") query += `userCode=${encodeURIComponent(value.trim())}`;
            else if (field === "email") query += `email=${encodeURIComponent(value.trim())}`;
            else if (field === "phone") query += `phoneNumber=${encodeURIComponent(value.trim())}`;

            try {
                const res = await fetch(`/Admin/CheckUnique?${query}`);
                if (res.ok) {
                    const data = await res.json();
                    if (field === "userCode") {
                        const el = document.getElementById("userCodeFeedback");
                        el.innerHTML = data.isUserCodeTaken ? `<span style="color: #ef4444;"> Mã số "${value}" đã tồn tại!</span>` : `<span style="color: #10b981;">✓ Hợp lệ</span>`;
                    } else if (field === "email") {
                        const el = document.getElementById("emailFeedback");
                        el.innerHTML = data.isEmailTaken ? `<span style="color: #ef4444;"> Email "${value}" đã tồn tại!</span>` : `<span style="color: #10b981;">✓ Hợp lệ</span>`;
                    } else if (field === "phone") {
                        const el = document.getElementById("phoneFeedback");
                        el.innerHTML = data.isPhoneTaken ? `<span style="color: #ef4444;"> Số điện thoại "${value}" đã tồn tại!</span>` : `<span style="color: #10b981;">✓ Hợp lệ</span>`;
                    }
                }
            } catch (err) { }
        }

        if (userCodeInput) userCodeInput.addEventListener("blur", function () { checkUnique("userCode", this.value); });
        if (emailInput) emailInput.addEventListener("blur", function () { checkUnique("email", this.value); });
        if (phoneInput) phoneInput.addEventListener("blur", function () { checkUnique("phone", this.value); });
    });
</script>
