                } catch (err) {
                    console.error("Assign homeroom error:", err);
                    showMessage('error', 'Lỗi kết nối đến máy chủ.');
                } finally {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerText = 'Phân công';
                    }
                }
            });
        }

        const assignTeachingForm = document.getElementById("assignTeachingForm");
        if (assignTeachingForm) {
            assignTeachingForm.addEventListener("submit", async function (e) {
                e.preventDefault();
                const submitBtn = assignTeachingForm.querySelector('button[type="submit"]');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerText = 'Đang phân công...';
                }
                const formData = new FormData(assignTeachingForm);
                try {
                    const response = await fetch(assignTeachingForm.action, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: formData
                    });
                    const result = await response.json();
                    
                    if (result.success) {
                        showMessage('success', result.message);
                        try {
                            const teachingResp = await fetch(`/Admin/GetClassTeachersJson/${classId}`);
                            if (teachingResp.ok) {
                                const teachingList = await teachingResp.json();
                                rebuildTeachingTable(teachingList);
                            }
                        } catch (rebuildErr) {
                            console.warn("Could not refresh teaching table dynamically", rebuildErr);
                        }
                        
                        const subjectSelect = document.getElementById('assignSubjectSelect');
                        const teacherSelect = document.getElementById('assignTeacherSelect');
                        if (subjectSelect) subjectSelect.value = '';
                        if (teacherSelect) teacherSelect.value = '';
                        if (subjectSelect && subjectSelect.refreshAutocomplete) subjectSelect.refreshAutocomplete();
                        if (teacherSelect && teacherSelect.refreshAutocomplete) teacherSelect.refreshAutocomplete();
                    } else {
                        showMessage('error', result.message || 'Không thể phân công giảng dạy.');
                    }
                } catch (err) {
                    console.error("Assign teaching error:", err);
                    showMessage('error', 'Lỗi kết nối đến máy chủ.');
                } finally {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerText = 'Phân Công';
                    }
                }
            });
        }

        // ========================================================
        // SCHEDULE / TIMETABLE LOGIC
        // ========================================================
        let currentSchedules = @Html.Raw(Json.Serialize(schedules)) || [];
        let classAssignments = @Html.Raw(Json.Serialize(teachingAssignments)) || [];
        const className = "@(classInfo?.Name ?? "")";
        const schoolYear = "@(classInfo?.SchoolYear ?? "2025-2026")";
        let editingScheduleId = null;
        let deleteScheduleTargetId = null;
        function getDayName(day) {
            switch(parseInt(day, 10)) {
                case 2: return "Thứ Hai";
                case 3: return "Thứ Ba";
                case 4: return "Thứ Tư";
                case 5: return "Thứ Năm";
                case 6: return "Thứ Sáu";
                default: return `Thứ ${day}`;
            }
        }

        // 1. Rebuild Schedule Grid HTML
        window.rebuildScheduleGrid = function(schedulesList) {
            currentSchedules = schedulesList || [];
            
            for (let period = 1; period <= 10; period++) {
                for (let day = 2; day <= 6; day++) {
                    const cell = document.querySelector(`.schedule-cell[data-day="${day}"][data-period="${period}"]`);
                    if (!cell) continue;

                    const item = currentSchedules.find(s => s.dayOfWeek === day && s.period === period);
                    if (item) {
                        const isEditing = editingScheduleId === item.id;
                        cell.innerHTML = `
                            <div class="schedule-item ${isEditing ? 'is-editing' : ''}" 
                                 data-id="${item.id}" 
                                 data-subject-id="${item.subjectId}" 
                                 data-subject-name="${item.subjectName}" 
                                 data-teacher-id="${item.teacherId}" 
                                 data-teacher-name="${item.teacherName}" 
                                 data-day="${item.dayOfWeek}" 
                                 data-period="${item.period}" 
                                 data-room="${item.room}"
                                 onclick="handleScheduleCellClick(event, '${item.id}')"
                                 style="background-color: #e0e7ff; border-left: 4px solid var(--color-primary); padding: 4px 6px; border-radius: 4px; height: 100%; display: flex; flex-direction: column; justify-content: space-between; position: relative; cursor: pointer;">
                                <button type="button" class="delete-schedule-btn" onclick="onDeleteScheduleBtnClick(event, '${item.id}', '${item.subjectName}', '${item.teacherName}', ${item.dayOfWeek}, ${item.period})" title="Xóa tiết học này">
                                    ✕
                                </button>
                                <div class="sub" style="font-weight: 700; color: #312e81; font-size: 0.78rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 14px;">${item.subjectName}</div>
                                <div class="teacher" style="color: #4338ca; font-size: 0.73rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">GV: ${item.teacherName}</div>
                                <div class="room" style="color: #6366f1; font-size: 0.68rem; font-weight: 600; text-align: right;"> ${item.room}</div>
                            </div>
                        `;
                    } else {
                        cell.innerHTML = '';
                    }
                }
            }
        };

        // 3. Subject Select Change: Auto-select teacher & suggest room
        const scheduleSubjectSelect = document.getElementById('scheduleSubjectSelect');
        if (scheduleSubjectSelect) {
            scheduleSubjectSelect.addEventListener('change', function () {
                const selectedSubId = this.value;
                const teacherSelect = document.getElementById('scheduleTeacherSelect');
                const autoBadge = document.getElementById('teacherAutoSelectBadge');
                const roomSelect = document.getElementById('scheduleRoomSelect');

                if (!selectedSubId) {
                    if (autoBadge) autoBadge.style.display = 'none';
                    return;
                }

                // Check Teaching Assignments
                const assigned = classAssignments.find(a => a.subjectId.toLowerCase() === selectedSubId.toLowerCase());
                if (assigned && teacherSelect) {
                    teacherSelect.value = assigned.teacherId;
                    if (autoBadge) {
                        autoBadge.style.display = 'inline-block';
                        autoBadge.innerText = ` Phân công: ${assigned.teacherName}`;
                    }
                } else {
                    if (autoBadge) autoBadge.style.display = 'none';
                }

                // Suggest Room based on subject
                const opt = this.options[this.selectedIndex];
                const subjectName = (opt ? (opt.dataset.baseName || opt.text) : '').toLowerCase();

                if (roomSelect) {
                    if (subjectName.includes('tin học') || subjectName.includes('tin')) {
                        roomSelect.value = 'Phòng Tin Học 1';
                    } else if (subjectName.includes('thể dục') || subjectName.includes('thể chất')) {
                        roomSelect.value = 'Nhà Đa Năng (Thể Dục)';
                    } else if (subjectName.includes('hóa') || subjectName.includes('sinh')) {
                        roomSelect.value = 'Phòng Lab Hóa - Sinh';
                    } else if (subjectName.includes('vật lý') || subjectName.includes('vật lí')) {
                        roomSelect.value = 'Phòng Lab Vật Lý';
                    } else {
                        // Default classroom based on class name (e.g. 10A1 -> Phòng 101, 10A2 -> Phòng 102)
                        const defaultRoom = className.includes('10A1') ? 'Phòng 101' :
                                           (className.includes('10A2') ? 'Phòng 102' :
                                           (className.includes('10A3') ? 'Phòng 103' :
                                           (className.includes('11A1') ? 'Phòng 201' :
                                           (className.includes('11A2') ? 'Phòng 202' :
                                           (className.includes('12A1') ? 'Phòng 301' : 'Phòng 101')))));
                        if (roomSelect.querySelector(`option[value="${defaultRoom}"]`)) {
                            roomSelect.value = defaultRoom;
                        }
                    }
                }
            });
        }

        // 4. Click on a Timetable Cell -> Switch Form to Edit Mode
        window.handleScheduleCellClick = function(e, scheduleId) {
            const item = currentSchedules.find(s => s.id === scheduleId);
            if (!item) return;

            editingScheduleId = scheduleId;

            // Highlight in grid
            document.querySelectorAll('.schedule-item').forEach(el => el.classList.remove('is-editing'));
            const targetEl = document.querySelector(`.schedule-item[data-id="${scheduleId}"]`);
            if (targetEl) targetEl.classList.add('is-editing');

            // Populate Form
            document.getElementById('editScheduleIdInput').value = item.id;
            document.getElementById('scheduleSubjectSelect').value = item.subjectId;
            document.getElementById('scheduleTeacherSelect').value = item.teacherId;
            document.getElementById('scheduleDay').value = item.dayOfWeek;
            document.getElementById('schedulePeriod').value = item.period;
            
            const roomSelect = document.getElementById('scheduleRoomSelect');
            if (roomSelect) roomSelect.value = item.room;

            // Update Form UI
            document.getElementById('scheduleFormTitle').innerText = ' Sửa Tiết Học';
            const subtitle = document.getElementById('scheduleFormSubtitle');
            if (subtitle) {
                subtitle.style.display = 'block';
                subtitle.innerText = `Đang chỉnh sửa Tiết ${item.period} (${getDayName(item.dayOfWeek)})`;
            }

            const submitBtn = document.getElementById('scheduleSubmitBtn');
            if (submitBtn) {
                submitBtn.innerHTML = ' Cập Nhật TKB';
                submitBtn.className = 'btn btn-warning';
                submitBtn.style.backgroundColor = '#f59e0b';
                submitBtn.style.borderColor = '#d97706';
                submitBtn.style.color = '#ffffff';
            }

            const cancelBtn = document.getElementById('scheduleCancelBtn');
            if (cancelBtn) cancelBtn.style.display = 'inline-block';

            // Check if teacher is standard assignment
            const assigned = classAssignments.find(a => a.subjectId.toLowerCase() === item.subjectId.toLowerCase());
            const autoBadge = document.getElementById('teacherAutoSelectBadge');
            if (assigned && autoBadge && assigned.teacherId.toLowerCase() === item.teacherId.toLowerCase()) {
                autoBadge.style.display = 'inline-block';
                autoBadge.innerText = ` Phân công: ${assigned.teacherName}`;
            } else if (autoBadge) {
                autoBadge.style.display = 'none';
            }
        };

        // 5. Cancel Edit Mode
        window.cancelScheduleEdit = function() {
            editingScheduleId = null;

            document.querySelectorAll('.schedule-item').forEach(el => el.classList.remove('is-editing'));

            document.getElementById('editScheduleIdInput').value = '';
            document.getElementById('scheduleSubjectSelect').value = '';
            document.getElementById('scheduleTeacherSelect').value = '';
            document.getElementById('scheduleDay').value = '2';
            document.getElementById('schedulePeriod').value = '1';

            const autoBadge = document.getElementById('teacherAutoSelectBadge');
            if (autoBadge) autoBadge.style.display = 'none';

            document.getElementById('scheduleFormTitle').innerText = 'Thêm Tiết Học';
            const subtitle = document.getElementById('scheduleFormSubtitle');
            if (subtitle) subtitle.style.display = 'none';

            const submitBtn = document.getElementById('scheduleSubmitBtn');
            if (submitBtn) {
                submitBtn.innerHTML = ' Thêm Vào TKB';
                submitBtn.className = 'btn btn-primary';
                submitBtn.style.backgroundColor = '';
                submitBtn.style.borderColor = '';
                submitBtn.style.color = '';
            }

            const cancelBtn = document.getElementById('scheduleCancelBtn');
            if (cancelBtn) cancelBtn.style.display = 'none';
        };

        // 6. Delete Single Schedule Cell
        window.onDeleteScheduleBtnClick = function(e, id, subjectName, teacherName, day, period) {
            if (e) {
                e.preventDefault();
                e.stopPropagation(); // Don't trigger cell edit
            }
            deleteScheduleTargetId = id;

            const textEl = document.getElementById('deleteScheduleConfirmText');
            if (textEl) {
                textEl.innerHTML = `Bạn có chắc chắn muốn xóa tiết <strong>${subjectName || 'học'}</strong> của giáo viên <strong>${teacherName || 'này'}</strong> khỏi <strong>Tiết ${period} (${getDayName(day)})</strong> không?`;
            }

            const modal = document.getElementById('deleteScheduleModal');
            if (modal) {
                modal.style.display = 'flex';
                setTimeout(() => modal.classList.add('show'), 10);
            }
        };

        window.closeDeleteScheduleModal = function() {
            deleteScheduleTargetId = null;
            const modal = document.getElementById('deleteScheduleModal');
            if (modal) {
                modal.classList.remove('show');
                setTimeout(() => { modal.style.display = 'none'; }, 200);
            }
        };

        window.executeDeleteSchedule = async function() {
            if (!deleteScheduleTargetId) return;

            const btn = document.getElementById('confirmDeleteScheduleBtn');
            if (btn) {
                btn.disabled = true;
                btn.innerText = 'Đang xóa...';
            }

            try {
                const formData = new FormData();
                formData.append('id', deleteScheduleTargetId);
                formData.append('classId', classId);

                const response = await fetch(`/Admin/DeleteSchedule`, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                });
                const result = await response.json();

                if (result.success) {
                    showMessage('success', result.message);
                    closeDeleteScheduleModal();
                    if (editingScheduleId === deleteScheduleTargetId) {
                        cancelScheduleEdit();
                    }
                    try {
                        const schedulesResp = await fetch(`/Admin/GetClassScheduleJson/${classId}`);
                        if (schedulesResp.ok) {
                            const schedulesList = await schedulesResp.json();
                            rebuildScheduleGrid(schedulesList);
                        }
                    } catch (rebuildErr) {
                        console.warn("Could not refresh schedule grid dynamically", rebuildErr);
                    }
                } else {
                    showMessage('error', result.message || 'Không thể xóa tiết học.');
                }
            } catch (err) {
                console.error("Delete schedule error:", err);
                showMessage('error', 'Lỗi kết nối đến máy chủ khi xóa tiết học.');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerText = '️ Xóa tiết học';
                }
            }
        };

        // 7. Create / Update Schedule Form Submission
        const createScheduleForm = document.getElementById("createScheduleForm");
        if (createScheduleForm) {
            createScheduleForm.addEventListener("submit", async function (e) {
                e.preventDefault();
                const submitBtn = document.getElementById('scheduleSubmitBtn');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerText = editingScheduleId ? 'Đang cập nhật...' : 'Đang thêm...';
                }

                const formData = new FormData(createScheduleForm);
                const actionUrl = editingScheduleId 
                    ? `/Admin/UpdateSchedule?id=${editingScheduleId}&classId=${classId}` 
                    : `/Admin/CreateSchedule?classId=${classId}`;

                try {
                    const response = await fetch(actionUrl, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: formData
                    });
                    const result = await response.json();

                    if (result.success) {
                        showMessage('success', result.message);
                        cancelScheduleEdit();
                        try {
                            const schedulesResp = await fetch(`/Admin/GetClassScheduleJson/${classId}`);
                            if (schedulesResp.ok) {
                                const schedulesList = await schedulesResp.json();
                                rebuildScheduleGrid(schedulesList);
                            }
                        } catch (rebuildErr) {
                            console.warn("Could not refresh schedule grid dynamically", rebuildErr);
                        }
                    } else {
                        showMessage('error', result.message || 'Không thể cập nhật thời khóa biểu.');
                    }
                } catch (err) {
                    console.error("Save schedule error:", err);
                    showMessage('error', 'Lỗi kết nối đến máy chủ.');
                } finally {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerText = editingScheduleId ? ' Cập Nhật TKB' : ' Thêm Vào TKB';
                    }
                }
            });
        }

        // Initialize lists on page load
        updateStudentsView();
        
        const initialAssignments = @Html.Raw(Json.Serialize(teachingAssignments)) || [];
        classAssignments = initialAssignments;
        rebuildTeachingTable(initialAssignments);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initClassDetailPage);
    } else {
        initClassDetailPage();
    }
</script>
